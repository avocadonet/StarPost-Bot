# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAH_your_bot_token_here

# ID целевой группы или канала (для супергрупп и каналов начинается с -100)
TARGET_GROUP_ID=-1001234567890

# Стоимость одной публикации в Telegram Stars (целое число)
STARS_PRICE=50

# Telegram ID администратора для получения алертов при сбоях
ADMIN_ID=123456789

# Путь к файлу базы данных SQLite
DB_PATH=transactions.db